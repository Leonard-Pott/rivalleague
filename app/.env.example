# Optional. Leer lassen genuegt im WLAN: die App nimmt dann die IP, ueber die
# Expo gerade den Bundler ausliefert, und haengt Port 3000 an (src/lib/config.ts).
# Setzen, wenn das Backend woanders laeuft - z.B. beim Android-Emulator mit
# "adb reverse tcp:3000 tcp:3000" oder bei einem deployten Server.
EXPO_PUBLIC_API_BASE=
